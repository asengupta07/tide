# Tide — environment template. Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# RPC endpoints
# ---------------------------------------------------------------------------
# Mainnet RPC (archive-capable, e.g. Alchemy). Anvil forks this for Aqua + v4 fills.
MAINNET_RPC_URL=
# Sepolia RPC. ENSv2 writes, live demo, agent record updates.
SEPOLIA_RPC_URL=
# RPC used only for eth_getLogs over wide ranges (Alchemy free tier caps at 10 blocks). Public node by default.
LOGS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Block to pin the fork at. Leave empty for latest.
FORK_BLOCK_NUMBER=

# ---------------------------------------------------------------------------
# Wallets (testnet burners only)
# ---------------------------------------------------------------------------
# Owner / maker. Ships the strategy, owns the ENS parent name, approves via World ID.
# Needs ~0.5 Sepolia ETH.
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=
# Manager agent. Holds the scoped EAC role; writes lambda / N / delta only.
# Needs ~0.1 Sepolia ETH.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# ---------------------------------------------------------------------------
# ENSv2 (Sepolia)
# ---------------------------------------------------------------------------
# Parent name registered by OWNER on the Sepolia ENSv2 app.
ENS_PARENT_NAME=tide.eth
# Strategy and agent subname labels. Scripts derive <label>.<ENS_PARENT_NAME>.
ENS_STRATEGY_LABEL=eth-usdc
ENS_AGENT_LABEL=manager
# Filled by scripts after deployment; leave empty initially.
ENS_STRATEGY_RESOLVER=
ENS_AGENT_ROLE_ID=

# ---------------------------------------------------------------------------
# World ID for Agents (official dev environment)
# ---------------------------------------------------------------------------
# Register a client at https://sandbox.auth.world.org
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=https://localhost:3000/api/world/callback
# Max age (seconds) of an ID token accepted for a protected write. Older tokens are rejected.
WORLD_MAX_TOKEN_AGE=120
# Seconds a proposal waits for the owner's fresh authentication before it is blocked as expired.
WORLD_APPROVAL_TIMEOUT_SECONDS=180

# Manager autopilot: measures realised ETH volatility every AGENT_TICK_MINUTES and proposes when
# lambda* moves at least AGENT_MIN_MOVE_BPS from the current setting. AGENT_AUTOPILOT=off disables it.
AGENT_TICK_MINUTES=15
AGENT_MIN_MOVE_BPS=500

# ---------------------------------------------------------------------------
# Backend / dashboard
# ---------------------------------------------------------------------------
PORT=3000
# RainbowKit / WalletConnect project id (https://cloud.walletconnect.com). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public URL of the dashboard for the ENS live-demo link.
PUBLIC_APP_URL=https://localhost:3000
# Address of the redeployed TideRouter and TideHook on the fork; scripts fill these.
TIDE_ROUTER_ADDRESS=
TIDE_HOOK_ADDRESS=
TIDE_APP_ADDRESS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Verify Sepolia contracts.
ETHERSCAN_API_KEY=
# Aqua resolver (KycNFT holder) to impersonate on the fork. Leave empty to auto-discover.
AQUA_TEST_RESOLVER=
