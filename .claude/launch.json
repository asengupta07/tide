{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "client",
        "dev",
        "--port",
        "3000",
        "--experimental-https",
        "--experimental-https-key",
        "./certificates/localhost-key.pem",
        "--experimental-https-cert",
        "./certificates/localhost.pem"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
